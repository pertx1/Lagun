# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (cron de notificaciones y borrado de cuenta). NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- IA del chat (solo servidor) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: cambia el modelo sin tocar código
AI_MODEL=claude-opus-5-5

# --- Web Push (genera con: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@lagun.app

# --- Cron (Vercel envía "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=cambia-esto

# URL pública de la app (para enlaces de confirmación de email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
