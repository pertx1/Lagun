# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (cron de notificaciones y borrado de cuenta). NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Dominio técnico para el email interno que Supabase necesita (no se envía ningún correo).
AUTH_EMAIL_DOMAIN=usuarios.lagun.app

# --- IA del chat (solo servidor). Gratis con Groq: https://console.groq.com/keys ---
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
# Opcional: cambia el modelo sin tocar código
AI_MODEL=openai/gpt-oss-120b
# Alternativa de pago: AI_PROVIDER=anthropic + ANTHROPIC_API_KEY=sk-ant-...

# --- Web Push (genera con: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@lagun.app

# --- Cron (GitHub Actions envía "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=cambia-esto
